<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="8dp"
        android:background="@color/background">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </RelativeLayout>

    <!-- Fixed-height scrolling header block: anime info + episode controls.
         Kept OUT of the same scroller as the episode RecyclerView on purpose — see below. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Anime Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:layout_margin="16dp"
                android:layout_marginBottom="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="96dp"
                    android:layout_height="136dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <ImageView
                        android:id="@+id/detail_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/detail_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/detail_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/btn_read_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Read more"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Episodes Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/episodes"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/episode_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btn_ep_search"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_search"
                    android:background="@drawable/bg_icon_circle"
                    android:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/btn_ep_reverse"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_swap_vert"
                    android:background="@drawable/bg_icon_circle"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/btn_ep_select"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Select"
                    android:textColor="@color/primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip" />

            </LinearLayout>

            <!-- Episode Search Box (toggled) -->
            <LinearLayout
                android:id="@+id/episode_search_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/episode_search_input"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_search"
                    android:hint="Search episode number or title"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

            </LinearLayout>

            <!-- Download All Button -->
            <TextView
                android:id="@+id/btn_download_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/download_all"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Episode list gets the REMAINING screen space and scrolls on its own —
         this keeps RecyclerView's item recycling intact even with 1000+ episodes.
         (A RecyclerView placed inside a wrap_content NestedScrollView has to lay out
         every item to measure itself, which is what was causing the freeze.) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/episode_compose_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Selection Action Bar (multi-episode download) -->
    <LinearLayout
        android:id="@+id/select_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_select_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_icon_circle"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/select_count_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="0 selected"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="Select All"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/btn_download_selected"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:text="Download"
            android:textColor="@color/on_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary" />

    </LinearLayout>

</LinearLayout>
